{
  "name": "bull-monitor",
  "version": "1.0.0",
  "engines": {
    "node": "24",
    "npm": "Use pnpm instead of npm.",
    "yarn": "Use pnpm instead of yarn."
  },
  "description": "Simple utility to monitor your BullMQ queues",
  "author": {
    "name": "Eric Hayes",
    "email": "eric@deployfx.com"
  },
  "private": true,
  "license": "MIT",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "ci:build": "npm run build && docker-compose build bull-monitor",
    "ci:publish": "npm run ci:build && docker-compose push bull-monitor",
    "format": "prettier --write .",
    "generate": "ACTION=createprocess MAX_JOB_DELAY_MS=200 LIMITER_MAX=200 CREATE_DELAY_MS=50 CONCURRENCY=15 ts-node bull_generator.ts",
    "generate:create": "ACTION=create CREATE_DELAY_MS=50 ts-node bull_generator.ts",
    "generate:process": "ACTION=process MAX_JOB_DELAY_MS=200 LIMITER_MAX=200 CONCURRENCY=15 ts-node bull_generator.ts",
    "generate:remove": "ACTION=remove ts-node bull_generator.ts",
    "services:start": "docker-compose up -d grafana redis",
    "services:start:all": "docker-compose up -d grafana bull-monitor",
    "services:stop": "docker-compose stop",
    "services:remove": "docker-compose rm --stop -f",
    "start": "dotenv -e environments/local.env -- ts-node -r tsconfig-paths/register src/daemon.ts",
    "start:dev": "dotenv -e environments/local.env -- nest start -- --watch",
    "start:debug": "dotenv -e environments/local.env -- nest start --debug --watch",
    "start:prod": "node dist/daemon",
    "lint": "eslint *.ts \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "npm run lint --fix",
    "precommit": "npm run lint && npm run build && npm run test && npm run test:e2e",
    "test:ci": "npm run test -- --coverage",
    "test": "dotenv -e environments/test.env -e environments/local.env -- jest",
    "test:watch": "dotenv -e environments/test.env -e environments/local.env -- jest --watch",
    "test:cov": "dotenv -e environments/test.env -e environments/local.env -- jest --coverage",
    "test:debug": "dotenv -e environments/test.env -e environments/local.env -- node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "dotenv -e environments/test.env -e environments/local.env -- jest --rootDir . --testRegex '.e2e-spec.ts$' --detectOpenHandles --forceExit",
    "transform_logs": "ts-node -r tsconfig-paths/register src/transform_logs.ts"
  },
  "dependencies": {
    "@bull-board/api": "^6.15.0",
    "@bull-board/express": "^6.15.0",
    "@bull-board/nestjs": "^6.15.0",
    "@bull-board/ui": "^6.15.0",
    "@liaoliaots/nestjs-redis": "^10.0.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^8.1.1",
    "@sentry/node": "^10.30.0",
    "@sentry/tracing": "^7.120.4",
    "async-mutex": "^0.5.0",
    "bull-master": "^1.0.5",
    "bullmq": "^5.66.0",
    "commander": "^14.0.2",
    "envalid": "^8.1.1",
    "ioredis": "^5.8.2",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "source-map-support": "^0.5.21",
    "tiny-typed-emitter2": "^1.0.0",
    "winston": "^3.19.0"
  },
  "jest": {
    "moduleNameMapper": {
      "^@app/(.*)$": "<rootDir>/src/$1"
    },
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "coveragePathIgnorePatterns": [
      "interfaces",
      "enums",
      "<rootDir>/src/app.module.ts",
      "<rootDir>/src/daemon.ts",
      "<rootDir>/src/main.ts",
      "<rootDir>/src/transform_logs.ts"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageReporters": [
      "text",
      "lcov"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  },
  "packageManager": "pnpm@10.26.0",
  "devDependencies": {
    "@auto-it/all-contributors": "^11.3.6",
    "@auto-it/docker": "^11.3.6",
    "@auto-it/first-time-contributor": "^11.3.6",
    "@auto-it/released": "^11.3.6",
    "@eslint/js": "^9.39.2",
    "@faker-js/faker": "^10.1.0",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.2",
    "@types/supertest": "^6.0.3",
    "auto": "^11.3.6",
    "chalk": "^5.6.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0"
  }
}
